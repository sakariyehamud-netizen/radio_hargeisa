# =============================================================================
# RADIO HARGEYSA — ENVIRONMENT CONFIGURATION
# =============================================================================

# 1. SUPABASE / POSTGRESQL DATABASE
# Option A: Connection String (Recommended for Supabase)
# Find in Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# For Supabase Session/Transaction Pooler (Port 6543):
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Option B: Individual connection parameters (Alternative to DATABASE_URL)
# SQL_HOST="aws-0-[REGION].pooler.supabase.com"
# SQL_PORT=6543
# SQL_DB_NAME="postgres"
# SQL_USER="postgres.[YOUR-PROJECT-REF]"
# SQL_PASSWORD="[YOUR-PASSWORD]"
# SQL_SSL=true

# 2. GOOGLE GEMINI AI
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-2.5-flash"

# 3. SERVER & AUTH SETTINGS
PORT=3000
APP_URL="http://localhost:3000"
SESSION_SECRET="rh_somaliland_session_secret_change_me_in_production"
NODE_ENV="development"
